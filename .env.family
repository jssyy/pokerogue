# Playing against the family account service (server/), the mode this build is meant to be used in.
#
# Login is NOT bypassed: the whole point is that a child signs in, so their progress follows the
# account rather than the browser, and so grading can be tied to a parent. `start:dev` bypasses it,
# which is why it drops straight into the game with no sign-in.
VITE_BYPASS_LOGIN=0
VITE_BYPASS_TUTORIAL=0
VITE_SERVER_URL=http://localhost:8001
# Unused: sign-in goes through the family service, not Discord or Google.
VITE_DISCORD_CLIENT_ID=1234567890
VITE_GOOGLE_CLIENT_ID=1234567890
VITE_I18N_DEBUG=0
VITE_PORT=8000
